{"id":"006ea9f2-1004-4e56-8d72-9597c63feb21","rule_id":"f9b76fad-de4d-42fb-a036-3b2aa76097c3","name":"Brute-force SMB success","immutable":false,"rule_source":{"type":"internal"},"version":1,"revision":3,"updated_at":"2026-10-19T01:31:59.799Z","updated_by":"elastic","created_at":"2026-10-13T01:25:00.741Z","created_by":"elastic","enabled":true,"interval":"1m","from":"now-2m","to":"now","description":"Detects four or more failed authentication attempts (4625) followed by a successful network logon (4624) from the same IP address to the same account within one minute.","tags":[],"author":[],"license":"","threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0006","name":"Credential Access","reference":"https://attack.mitre.org/tactics/TA0006/"},"technique":[{"id":"T1110","name":"Brute Force","reference":"https://attack.mitre.org/techniques/T1110/","subtechnique":[{"id":"T1110.001","name":"Password Guessing","reference":"https://attack.mitre.org/techniques/T1110/001/"}]}]}],"related_integrations":[],"required_fields":[],"setup":"","false_positives":[],"references":[],"risk_score":73,"risk_score_mapping":[],"severity":"high","severity_mapping":[],"output_index":"","max_signals":100,"exceptions_list":[],"actions":[],"meta":{"kibana_siem_app_url":"http://192.168.158.10:5601/app/security"},"type":"eql","language":"eql","index":["logs-*"],"query":"sequence by winlog.event_data.TargetUserName, source.ip with maxspan=1m\n  [authentication where event.code == \"4625\"]\n  [authentication where event.code == \"4625\"]\n  [authentication where event.code == \"4625\"]\n  [authentication where event.code == \"4625\"]\n  [authentication where event.code == \"4624\" and winlog.logon.type == \"Network\"]","filters":[]}
